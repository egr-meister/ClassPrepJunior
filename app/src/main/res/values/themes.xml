<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ClassPrep" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
    </style>

    <!-- Launch screen: shown only while the app actually loads (no artificial delay). -->
    <style name="Theme.ClassPrep.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/paper</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.ClassPrep</item>
    </style>
</resources>
